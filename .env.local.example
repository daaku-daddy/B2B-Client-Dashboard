NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZtd3Z4d3F6cXhod2Vzam9renRmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwNjA0MTUsImV4cCI6MjEwNDYzNjQxNX0.RwdhJlYRTyyT3-Y6d4wCRhvaR6CPFagAgl6YDN4z9DI

# Server-only. Needed by /api/sync/referrals (writes rows no partner may write).
# Get it from Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Material Depot catalogue. api.materialdepot.com/apiV1/search/ rejects our
# origin today (Django CSRF) — see docs/catalogue.md.
MD_CATALOGUE_BASE=https://api.materialdepot.com/apiV1
MD_CATALOGUE_ORIGIN=https://materialdepot.com

# Django CRM, for the referral sync. Same host the CRM portal uses.
MD_CRM_BASE=https://api.materialdepot.com/apiV1
MD_CRM_TOKEN=

# Shared secret the sync route requires in x-sync-key.
SYNC_SHARED_SECRET=

# ---------------------------------------------------------------- optional
# Everything below is OPTIONAL. The app is correct with all of it unset — see
# the table in CLAUDE.md § Deploying for what each one falls back to.

# The B2B support desk, shown on the KAM card when a firm has no KAM assigned
# yet (PRD §13.5). Left blank on purpose: an invented number in a live partner
# app means a partner rings a stranger. Unset, the card says any Material Depot
# store can help instead of printing one.
NEXT_PUBLIC_B2B_DESK_PHONE=
NEXT_PUBLIC_B2B_DESK_EMAIL=
NEXT_PUBLIC_B2B_DESK_HOURS=

# Stamped on every analytics event as `app_version` (PRD §14.6.3). Defaults to
# 'dev', which is harmless until a vendor is connected and then means every
# production event is labelled dev.
NEXT_PUBLIC_APP_VERSION=

# No analytics vendor is wired. lib/analytics/track.ts queues events to
# window.__mdEvents and sendToVendors() is a deliberate no-op — docs/analytics.md
# has why, and what connecting one costs (one function, one file).
# NEXT_PUBLIC_MIXPANEL_TOKEN=
# NEXT_PUBLIC_CLARITY_ID=
